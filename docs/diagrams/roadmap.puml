@startuml roadmap
!include _style.iuml
skinparam linetype ortho
skinparam rectangle {
  BackgroundColor #FFFFFF
}

rectangle "**Phase 1**\nDaily editor\nM0–M6\n--\nFolder, tree, editor\nVim, terminal\nMarkdown preview" as P1
rectangle "**Phase 2**\nCode intelligence\nM7–M9\n--\nLanguage servers\nProject search\nQuickfix" as P2
rectangle "**Phase 3**\nViewers\nM10–M12\n--\nImages\nPDF\nSeparate preview" as P3
rectangle "**Phase 4**\nShipping\nM13–M14\n--\nSeveral windows\nPackaging\nInstall guide" as P4
rectangle "**Phase 5**\nDaily use\nM15–M67\n--\nSession, settings, Git\nTasks, history\nMore languages" as P5
rectangle "**Phase 6**\nDebugger, polish\nM68–M82\n--\nDebugger, 4 languages\nAuto-update\nDocs Hub, themes" as P6

P1 -right-> P2
P2 -right-> P3
P3 -right-> P4
P4 -right-> P5
P5 -right-> P6

package "Planned (plans of 2026-11-16)" {
  rectangle "**Git and review**\n--\nGit log\nDiff and merge" as G1 #line.dashed
  rectangle "**Run and debug**\n--\nTest runner\nLaunch configs\nVS Code tasks\nEmbedded debugger" as G2 #line.dashed
  rectangle "**Languages**\n--\nMore languages\nFormatters\nC#/.NET\nEmbedded basics" as G3 #line.dashed
  rectangle "**Editor**\n--\nAgent (ACP)\nBreadcrumb\nProse check\nVim fidelity, QoL" as G4 #line.dashed
}
P2 -[hidden]down- G1
G1 -[hidden]right- G2
G2 -[hidden]right- G3
G3 -[hidden]right- G4
caption Fig. 7 – Milestones in order
@enduml
