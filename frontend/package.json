{
  "name": "ayaz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run --project node",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.css\"",
    "lint": "prettier --check \"src/**/*.css\" && stylelint \"src/**/*.css\"",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test"
  },
