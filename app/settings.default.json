// Ayaz settings. Saving applies them right away, no restart.
// Comments and trailing commas are allowed. Delete a line to get its default back.
// keymap.json in this folder holds your key bindings.
{
  // Editor font, put in front of the built-in monospace fonts (they stay as fallbacks for Nerd Font icons).
  // "" keeps the built-in ones. Example: "JetBrains Mono"
  "font": "",

  // Font size of the editor and the terminal in px, 6 to 48. Cmd+= / Cmd+- zoom on top of it.
  "fontSize": 13,

  // The terminal's own font size, if it should differ from fontSize.
  // "terminalFontSize": 13,

  // Parameter names and types from the language server, shown inline.
  "inlayHints": false,

  // The language server's own knowledge of what each name is (function, type, parameter, ...) colours the code
  // over the syntax highlighting. Needs a server that offers it (gopls, clangd, TypeScript, jdtls).
  "semanticTokens": true,

  // Functions and classes whose first line has scrolled out of view stay on top of the editor; a click jumps there.
  "stickyScroll": true,

  // The file tree's side of the window: "left" or "right". Cmd+B hides and shows it.
  "sidebar": "left",

  // Where mode, messages, errors, branch and position go: "top" (the title bar) or "bottom" (a line under the code).
  "statusline": "top",

  // Optional translucent chrome and blur on floating overlays; solid is the default.
  // "glass": false,
  // How see-through glass is, 0.3 (very) to 1 (as designed). The palette (<Space>fk) has "Toggle transparency", which switches it live.
  // "glassOpacity": 1,

  // The color theme: chrome, editor syntax and terminal together. Built in: "graphite", "kanagawa", "tokyo-night",
  // "catppuccin-mocha", "gruvbox-dark", plus every name in "themes" below. <Space>ft switches for this session.
  "theme": "graphite",

  // Your own themes, each on top of another one ("extends", default "graphite"): name only what you change.
  // A theme named like a built-in one ("tokyo-night") changes that one.
  // Parts: "ui" (bg0 bgSidebar bgTabs tab tabActive bg1 bg2 bg3 hover overlay edge edgeSplit edgeOverlay fg1-fg4
  // accent insert visual error warning gitAdd gitMod gitDel statusNormal statusInsert statusVisual statusReplace
  // statusTerminal statusRead statusView statusError statusWarning), "syntax" (fg comment keyword fn string number
  // type constant operator punct special field param error cursor selection lineHighlight) and "terminal"
  // (background foreground cursor selectionBackground black red green yellow blue magenta cyan white and the bright
  // variants, e.g. brightRed). Colors are hex or rgb(...) strings.
  "themes": {
    // "mine": {
    //   "extends": "kanagawa",
    //   "ui": { "bg0": "#101014", "accent": "#7aa2f7" },
    //   "syntax": { "keyword": "#bb9af7" },
    //   "terminal": { "red": "#f7768e" },
    // },
  },

  // Colors of the mode name and the error and warning counts, as hex. They go over the theme. Delete a key to get its default back.
  // Keys: normal, insert, visual, replace, terminal, read, view, error, warning.
  "statusColors": {
    // "normal": "#7e9cd8",
    // "insert": "#98bb6c",
  },

  // Commands to run in the folder by name: <Space>rr picks one, <Space>rl runs the last again.
  // They run in a terminal split; file:line:col lines in the output land in the quickfix list.
  "tasks": {
    // "vet": "go vet ./...",
    // "test": "go test ./...",
  },

  // Width of a tab, and the indent unless "tabs" is on. 1 to 16.
  "tabWidth": 4,

  // Indent with tabs instead of spaces.
  "tabs": false,

  // Wrap long lines. <Space>uw toggles it for the open file.
  "wrap": false,

  // Format through the language server when saving.
  "formatOnSave": false,

  // Per language, keyed by file extension. Overrides tabWidth, tabs, wrap and formatOnSave for those files.
  "languages": {
    "go": { "tabs": true, "formatOnSave": true },
    "md": { "wrap": true },
    // "ts": { "tabWidth": 2 },
  },
}
